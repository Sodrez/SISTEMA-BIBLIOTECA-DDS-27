<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

    <main class="container my-2 flex-grow-1">
        <h1 class="fg-accent fs-6x1"> 
            ESTOU NA PÁGINA DE CRIAR LIVROS
        </h1>

        <!-- CRIAR O FORMULÁRIO DE CADASTRO -->
        <div class="d-flex flex-column">
            <!-- action - Fala a rota que o botão vai enviar as informações -->
            <form action="/usuarios/cadastrar" method="post">
                
                <!-- CAIXINHA DE NOME -->
                <div class="form-group">
                    <label for="nome"> Titulo: </label>
                    <input type="text" name="nome" id="nome" class="form-control" required>
                </div>

                <!-- CAIXINHA DE EMAIL -->
                <div class="form-group">
                    <label for="email"> Autor: </label>
                    <input type="text" name="nome" id="nome" class="form-control" required>
                </div>

                <!-- CAIXINHA DE PERFIL -->
                <div class="form-group">
                    <label for="senha"> Gênero: </label>
                    <select name="Gênero" id="Gênero" class="form-control">
                        <option value="Ação"> Ação</option>
                        <option value="Ficção"> Ficção</option>
                        <option value="Drama"> Drama</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="email"> Ano de lançamento: </label>
                    <input type="date" name="data" id="data" class="form-control" required>
                </div>

                <div class="form-group">
                    <label for="senha"> Visibilidade do Sistema: </label>
                    <select name="Visibilidade" id="Visibilidade" class="form-control">
                        <option value="Ativo"> Ativo</option>
                        <option value="Desativado"> Desativado</option>
                    </select>
                </div>

                <!-- BOTAO DE POSTAR LIVRO -->
                <button type="submit" class="btn-subtle theme-success mt-3"> 
                    Postar Livro 
                </button>                
            </form>
        </div>
    </main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>